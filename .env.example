# Live inference is opt-in. Leave off until credits and hosting rate limits are ready.
ENABLE_LIVE_AI=false

# Copy to .env.local and fill in. Never commit .env.local.

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model IDs: run `npm run smoke` to list the Nemotron models your key can see
NEBIUS_MODEL_NANO=
NEBIUS_MODEL_SUPER=
NEBIUS_MODEL_ULTRA=

# Optional: none | low | medium | high. Leave empty for Nebius.
# No Nebius credits yet? Any OpenAI-compatible server works. Local Qwen via Ollama:
#   NEBIUS_BASE_URL=http://localhost:11434/v1/  NEBIUS_API_KEY=ollama
#   NEBIUS_MODEL_NANO/SUPER/ULTRA=qwen3.5:4b    NEBIUS_REASONING_EFFORT=none
# "none" stops Qwen thinking first (~5s a reply instead of ~20s, under the 25s timeout).
NEBIUS_REASONING_EFFORT=

# Tavily (gas prices, manufacturer schedules)
TAVILY_API_KEY=

# Google Maps Platform: server key for Places API (New) and Routes API,
# separate browser key restricted to the Vercel domain and Maps Embed API
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Postgres (Neon or Supabase)
DATABASE_URL=
# Direct Neon connection for schema migrations (pulled by neon deploy).
DATABASE_URL_UNPOOLED=

# EIA weekly gas price fallback
EIA_API_KEY=

# Explicit opt-in for potentially billable Google Places/Routes requests.
# Set provider quotas and restrict the server key before enabling.
ENABLE_MAPS=false

# Daily cloud weather checks. Keep disabled until database migration and release.
# Vercel cron invokes production only; users must separately opt in.
ENABLE_DAILY_WEATHER=false
CRON_SECRET=

# Opt in only after Tavily quota/credit limits are configured. No generated answer.
ENABLE_TAVILY=false

# Copy to .env.local and fill in. Never commit .env.local.

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model IDs: run `npm run smoke` to list the Nemotron models your key can see
NEBIUS_MODEL_NANO=
NEBIUS_MODEL_SUPER=
NEBIUS_MODEL_ULTRA=

# Tavily (gas prices, manufacturer schedules)
TAVILY_API_KEY=

# Google Maps Platform: server key for Geocoding/Places/Routes,
# browser key (restricted to the Vercel domain) for Maps JS
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Postgres (Neon or Supabase)
DATABASE_URL=

# EIA weekly gas price fallback
EIA_API_KEY=
